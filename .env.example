# Supabase 프로젝트 연결 정보.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
#
# 값 위치: Supabase 대시보드 → Project Settings → API
#
# anon key 는 공개 키입니다. 브라우저 번들에 그대로 들어가며, 그래도 되는
# 이유는 데이터를 막는 것이 이 키가 아니라 RLS 정책이기 때문입니다.
# service_role 키는 절대 여기 넣지 마세요 — RLS를 통째로 우회합니다.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 아래는 시드 스크립트(scripts/seed.ts)에서만 쓰는 서버 전용 키입니다.
# npm run seed 를 돌릴 때만 필요하고, 프론트엔드 번들에는 들어가지 않습니다.
# VITE_ 접두사가 없는 것이 그 장치입니다.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 선택. 시드 계정 비밀번호를 고정하고 싶을 때만 쓰세요.
# 비워두면 실행할 때마다 새로 만들어 터미널에 출력합니다.
# 저장소가 공개라서 소스에 하드코딩하지 않습니다.
# SEED_PASSWORD=
